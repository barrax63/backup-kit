# Host port where nginx exposes the HTTPS service (maps to the container's
# internal port 8443, which is fixed in nginx/nginx.conf).
NGINX_PORT=4096

# Set this to true if you run zerobyte behind a reverse-proxy and want to avoid all client sharing the same rate limiting bucket.
TRUST_PROXY=true

# This secret will be used to encrypt data in the database
# Generate your secret with: openssl rand -hex 32
APP_SECRET=

# This variable defines the URL used to access your instance
# (e.g., BASE_URL=https://your-domain.com or BASE_URL=http://your-ip:port)
BASE_URL=
